# Salin jadi .env (JANGAN commit .env). Semua opsional kecuali GEMINI_API_KEY untuk jawaban generatif.
GEMINI_API_KEY=
# Kunci rahasia bersama dengan backend Node. Kosong = mode dev (tanpa cek header).
AE_INTERNAL_KEY=
# Model Gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BACKUP_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=10
GEMINI_RETRIES=2
GEMINI_BACKOFF=1.0
GEMINI_TOTAL_BUDGET=25
# Classifier
AE_CONF_THRESHOLD=0.50
AE_MAX_LEN=500
AE_MODEL_VERSION=logreg-tfidf-11label-2026-11-21
# CORS mati secara default. Isi hanya kalau disepakati frontend memanggil langsung (dipisah koma).
AE_CORS_ORIGINS=
